{
  "name": "beastx-ctl",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "turbo run typecheck typecheck:effect",
    "test": "turbo run test",
    "check": "turbo run typecheck typecheck:effect test && bun run lint && bun run format:check && bun run knip && bun run complexity",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:files": "oxlint --config oxlint.config.ts --no-error-on-unmatched-pattern",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "complexity": "cccc --no-config --max-cognitive 15 --exclude '**/*.test.ts' --table --min 10 packages/*/src"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/tsgo": "0.69.0",
    "@types/bun": "1.4.4",
    "@yielded/effect-tsrs": "0.2.3",
    "knip": "6.45.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "ultracite": "8.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "lefthook"
  ]
}
